{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gage-grid.vercel.app/data/site.schema.json",
  "title": "Gage Grid Site Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_id","name","state","county","status","updated_at"],
  "properties": {
    "site_id": {"type":"string","minLength":1},
    "name": {"type":"string","minLength":1},
    "state": {"type":"string","minLength":2,"maxLength":2},
    "county": {"type":"string","minLength":1},
    "latitude": {"type":["number","null"],"minimum":-90,"maximum":90},
    "longitude": {"type":["number","null"],"minimum":-180,"maximum":180},
    "parcel_reference": {"type":["string","null"]},
    "status": {"enum":["Active","Watch","Stale","Archived"]},
    "power_redundancy_level": {"type":["integer","null"],"minimum":1,"maximum":3},
    "tags": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "notes": {"type":["string","null"]},
    "updated_at": {"type":"string","format":"date-time"}
  }
}
