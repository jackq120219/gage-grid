{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gage-grid.vercel.app/data/record.schema.json",
  "title": "Gage Grid Capacity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "site_id",
    "system",
    "usable_headroom",
    "unit",
    "evidence",
    "confidence",
    "source_uri",
    "retrieval_date",
    "service_territory",
    "methodology",
    "lead_time_months",
    "utility_verification_status",
    "updated_at"
  ],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "site_id": {"type":"string","minLength":1},
    "system": {"enum":["Power","Water","Wastewater","Gas","Fiber"]},
    "usable_headroom": {"type":"number","minimum":0},
    "raw_capacity": {"type":["number","null"],"minimum":0},
    "unit": {"type":"string","minLength":1},
    "evidence": {"enum":["Verified","Reported","Modeled"]},
    "confidence": {"type":"integer","minimum":0,"maximum":100},
    "source_uri": {"type":"string","format":"uri"},
    "source_title": {"type":["string","null"]},
    "retrieval_date": {"type":"string","format":"date"},
    "effective_date": {"type":["string","null"],"format":"date"},
    "service_territory": {"type":"string","minLength":1},
    "methodology": {"type":"string","minLength":1},
    "lead_time_months": {"type":"number","minimum":0},
    "known_constraints": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "redundancy_level": {"type":["integer","null"],"minimum":1,"maximum":3},
    "utility_verification_status": {"enum":["Not requested","Pending","Preliminary","Confirmed","Expired"]},
    "verification_reference": {"type":["string","null"]},
    "updated_at": {"type":"string","format":"date-time"},
    "notes": {"type":["string","null"]}
  }
}
